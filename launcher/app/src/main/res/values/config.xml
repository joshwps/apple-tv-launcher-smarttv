<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================================= -->
    <!-- CONFIGURAÇÕES PADRÃO DO LAUNCHER -->
    <!-- ========================================================= -->

    <!-- Layout e Aparência -->
    <integer name="columns">5</integer>
    <integer name="wallpaper_seconds">30</integer>
    <bool name="use_wallpaper">true</bool>

    <!-- Redes Sociais (Contadores) - Deixe vazio para ocultar -->
    <string name="youtube_channel"></string>
    <string name="instagram_user"></string>
    <string name="facebook_page"></string>

    <!-- Aplicativos Padrão da Dock (lidos na primeira execução) -->
    <string-array name="dock_packages">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.spotify.tv.android</item>
    </string-array>

    <!-- Aplicativos Ocultos (bloatware que não deve aparecer na grade) -->
    <string-array name="hidden_packages">
    </string-array>
</resources>
